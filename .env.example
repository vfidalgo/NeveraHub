# ==============================================================================
# NeveraHub: Variables de Configuración de Entorno (.env)
# Copia este archivo a .env y completa tus claves reales
# ==============================================================================

# 1. Servidor
PORT=3030
NODE_ENV=production

# 2. Supabase Cloud (Base de datos remota en la nube gratuita)
# Obtén estas claves en https://supabase.com -> Tu Proyecto -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# 3. Gemini Vision (Opcional - para reconocimiento facial inteligente)
# Obtén tu clave gratuita en https://aistudio.google.com/
GEMINI_API_KEY=tu-gemini-api-key-aqui

# 4. Web Push / Notificaciones Familiares (Opcional)
NTFY_TOPIC=neverahub_familia_alertas

# 5. Seguridad: PIN Familiar (4 dígitos para acceso Web y APK)
FAMILY_PIN=1234
